{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!.claude",
      "!out",
      "!build",
      "!next-env.d.ts",
      "!test-results",
      "!playwright-report",
      "!e2e/**/*-snapshots",
      "!docs/design/screenshots",
      "!platanus-hack-project.jsonc",
      "!README.md",
      "!CONTEXT.md",
      "!project-description.md",
      "!public",
      "!coverage",
      "!timeline"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "tailwind": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/lib/domain/**",
        "src/lib/use-cases/**",
        "src/lib/ports/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@neondatabase/**",
                      "drizzle-orm/**",
                      "drizzle-zod",
                      "@anthropic-ai/**",
                      "next/**",
                      "react",
                      "react-dom/**"
                    ],
                    "message": "Inside the hexagon. Depend on a port from src/lib/ports/; adapters live in src/lib/adapters/ and are wired in src/lib/composition.ts."
                  },
                  {
                    "group": ["**/adapters/**", "**/composition"],
                    "message": "Dependencies point inward. The core defines ports; adapters implement them. Take what you need as a parameter."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off",
            "noDoubleEquals": "off"
          },
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/domain/matching/demo.ts", "scripts/**"],
      "linter": {
        "rules": { "suspicious": { "noConsole": "off" } }
      }
    },
    {
      "includes": ["e2e/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  }
}

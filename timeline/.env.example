# Copy to timeline/.env (gitignored). Parsed manually by timeline/lib/narrator.ts
# — plain KEY=VALUE lines, "#" comments, optional single/double quotes on values.

# Vercel AI Gateway key. Missing key => the deterministic MOCK narrator is used
# everywhere (nothing crashes); output is marked meta.narration = 'mock'.
AI_GATEWAY_API_KEY=

# Optional: override the primary model (default moonshotai/kimi-k2.5;
# fallbacks deepseek/deepseek-v3.2, zai/glm-4.7-flash). Also readable as a
# process env var (process env wins over this file). The fallback chain becomes
# [override] + the remaining fallbacks minus duplicates. On free-tier gateway
# accounts set TIMELINE_MODEL=zai/glm-4.7-flash — the only accessible model.
# TIMELINE_MODEL=moonshotai/kimi-k2.5

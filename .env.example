# Copy to `.env` and fill in. `.env` -- not `.env.local` -- because drizzle-kit
# only reads `.env`, while Next.js reads both; one file keeps the app and the
# migration tool pointed at the same database.
#
# Preferred way to populate it, once `neon link` has run:
#
#     neon env pull
#
# Otherwise: Neon console -> project `hookai` -> Connect -> copy the pooled
# connection string for the branch you are working on.
#
# `hookai` is the product's former name, kept on the Neon project on purpose:
# the provider knows it by that name, and renaming it there would break every
# existing branch link for nothing this repo can see.

# Pooled connection string for the Neon branch this checkout works against.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon Object Storage -- participant photos (docs/domain.md D11, docs/storage.md).
# AWS-standard names, so `@aws-sdk/client-s3` reads all four from the environment.
# Written by `neon deploy` / `neon env pull` on the branch this checkout is linked
# to; move them here if the CLI wrote `.env.local`.
#
# `AWS_ENDPOINT_URL_S3` is the switch: set means photos go to the branch's
# `photos` bucket, unset means the fake `PhotoStore` (a `data:` URL) -- which is
# what Playwright and a checkout that never ran `neon deploy` use, so no e2e run
# uploads anything. Production and Preview on Vercel MUST carry all four, from the
# `production` and `ci-base` branches respectively.
# AWS_ACCESS_KEY_ID="nak_live_XXXXXXXX"
# AWS_SECRET_ACCESS_KEY="nsk_live_XXXXXXXX"
# AWS_ENDPOINT_URL_S3="https://br-BRANCH.storage.c-4.us-east-2.aws.neon.tech"
# AWS_REGION="us-east-2"

# The room `/intake` falls back to when the QR code carries no `?room=<slug>`.
# A slug, never an id: it is resolved against `rooms` on every request (D9).
#
# The `HOOKAI_` prefix is the product's former name. The variable is set in
# Vercel, so renaming it here alone would leave production without a default
# room; it stays until there is a reason to change both sides at once.
HOOKAI_ROOM_SLUG="platanus-hack-26-bogota"

# How many whole 15-block forms stay warm per room, and how many are written at
# once -- the second one IS the room's throughput: a form is ~130 s of waiting
# on the gateway, so 12 slots is ~5.5 forms a minute. UNSET means the venue
# defaults (24 / 12), which is what production runs: open /qr a few minutes
# before the first scan and the room fills before anyone needs it.
#
# Set small HERE on purpose. Opening /intake on a dev machine with the venue
# defaults would author two dozen forms against the real gateway, which is a
# surprising bill for `pnpm dev`. `0` turns warming off entirely (the e2e web
# server sets exactly that, playwright.config.ts).
HOOKAI_QUIZ_POOL_TARGET="2"
HOOKAI_QUIZ_POOL_SLOTS="2"

# Optional. The quiz asks for ONE option per block (a tap answers and advances).
# Set to 1 to bring back the two-mark elicitation ("Más yo" + "Menos yo" with an
# explicit "Siguiente"), which PILLARS.md §8 describes. Server-side only.
# HOOKAI_QUIZ_MOST_LEAST="1"

# AI Gateway — authors each participant's quiz blocks (docs/domain.md D16/D20).
# Create at https://vercel.com/[team]/~/ai-gateway/api-keys. One key covers text
# and image models; only text is used. REQUIRED for the quiz: there is no
# fallback content any more — without it every participant stays on the
# "Escribiendo tus preguntas…" screen, because the committed 15 blocks are never
# served to a person. The e2e suite seeds blocks directly and does not need it.
AI_GATEWAY_API_KEY="vck_..."

# Optional. Overrides the default `anthropic/claude-sonnet-5`.
# AI_MODEL="anthropic/claude-sonnet-5"

# The site gate (docs/site-gate.md). Empty or unset = no gate at all, which is
# what local dev, CI and every test run want. Setting it locks EVERY path --
# pages, Server Actions, /_next/* assets, robots.txt -- behind one shared
# password until it is typed at /gate. The real value lives only in Vercel
# (Production and Preview); this repo is public, so it is never written here.
SITE_GATE_PASSWORD=""

# Copy to `.env` and fill in. `.env` -- not `.env.local` -- because drizzle-kit
# only reads `.env`, while Next.js reads both; one file keeps the app and the
# migration tool pointed at the same database.
#
# Preferred way to populate it, once `neon link` has run:
#
#     neon env pull
#
# Otherwise: Neon console -> project `hookai` -> Connect -> copy the pooled
# connection string for the branch you are working on.

# Pooled connection string for the Neon branch this checkout works against.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# AI Gateway — authors each participant's quiz blocks (docs/domain.md D15).
# Create at https://vercel.com/[team]/~/ai-gateway/api-keys. One key covers text
# and image models; only text is used. Absent, generation degrades to the
# committed fallback instrument rather than failing, so local work without it is
# fine — you just get the same 15 blocks every time.
AI_GATEWAY_API_KEY="vck_..."

# Optional. Overrides the default `anthropic/claude-sonnet-5`.
# AI_MODEL="anthropic/claude-sonnet-5"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quest-skill block",
  "type": "object",
  "required": ["id", "focusPillar", "domain", "language", "scenario", "options", "imagePrompts"],
  "properties": {
    "id": { "type": "integer", "minimum": 1, "maximum": 15 },
    "focusPillar": { "enum": ["regulation", "politeness", "reliability", "agency"] },
    "domain": { "type": "string" },
    "language": { "type": "string" },
    "scenario": { "type": "string", "maxLength": 220 },
    "options": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["key", "text", "pillar", "keyed"],
        "properties": {
          "key": { "enum": ["a", "b", "c", "d"] },
          "text": { "type": "string", "maxLength": 60 },
          "pillar": { "enum": ["regulation", "politeness", "reliability", "agency"] },
          "keyed": { "enum": ["positive", "reversed"] }
        }
      }
    },
    "imagePrompts": {
      "type": "array", "minItems": 4, "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["option", "prompt"],
        "properties": {
          "option": { "enum": ["a", "b", "c", "d", "cover"] },
          "prompt": { "type": "string", "maxLength": 600 }
        }
      }
    }
  }
}
